{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "codegen"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "codegen": {
      "outputs": ["styled-system/**"]
    }
  }
}

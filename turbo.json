{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "codegen"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "codegen"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "codegen"],
      "outputs": []
    },
    "codegen": {
      "dependsOn": ["^codegen"],
      "inputs": [
        "panda.config.ts",
        "src/panda-preset.ts",
        "src/panda-scale.ts",
        "src/shared/config/norii-preset.ts"
      ],
      "outputs": ["styled-system/**"]
    }
  }
}
